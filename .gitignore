# Local / production secrets
.env
.env.*
!.env.example

# Local temporary files
.mytmp/
*.log
.DS_Store

# Local Tailwind standalone binary (runtime uses assets/css/style.css)
tailwindcss

# CMS uploads are runtime data stored only on the hosting server.
# Never push/pull uploaded media through Git.
/iluma/uploads/*
!/iluma/uploads/.gitignore

# MyLive DJ sets and assets are production runtime data.
# Never track, overwrite, pull, or redeploy user-uploaded files.
/mylive/storage/**
!/mylive/storage/.gitignore
!/mylive/storage/.htaccess

