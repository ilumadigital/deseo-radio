# Copy this file to .env and fill in the deployment values.
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
ADMIN_PASSWORD=change_this_admin_password

# SMTP for Season 6 approval emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=radio@iluma.gr
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_EMAIL=radio@iluma.gr
SMTP_FROM_NAME="Deseo Radio"
SMTP_REPLY_TO=radio@iluma.gr

# Cloudflare Turnstile for /dj inquiry form and /iluma CMS login
# Create a Turnstile widget for deseoradio.com in Cloudflare.
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_HOSTNAME=deseoradio.com

# Cloudflare Web Analytics
# Use the site token from Cloudflare Web Analytics -> Manage site.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=your_cloudflare_web_analytics_token


# MyLive PWA + targeted push notifications (Webpushr)
# Public key is safe to expose in the browser. API/auth/cron tokens must remain server-side only.
MYLIVE_WEBPUSHR_PUBLIC_KEY=your_webpushr_public_key
MYLIVE_WEBPUSHR_API_KEY=your_webpushr_rest_api_key
MYLIVE_WEBPUSHR_AUTH_TOKEN=your_webpushr_authentication_token
MYLIVE_PUSH_CRON_TOKEN=generate_a_long_random_secret
MYLIVE_BASE_URL=https://deseoradio.com
