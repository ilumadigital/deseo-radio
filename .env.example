# Copy this file to .env and fill in the deployment values.
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
ADMIN_PASSWORD=change_this_admin_password

# SMTP for Season 6 approval emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=radio@iluma.gr
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_EMAIL=radio@iluma.gr
SMTP_FROM_NAME="Deseo Radio"
SMTP_REPLY_TO=radio@iluma.gr
