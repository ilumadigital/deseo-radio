# Copy this file to .env and fill in the deployment values.
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
ADMIN_PASSWORD=change_this_admin_password

# SMTP for Season 6 approval emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=radio@iluma.gr
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_EMAIL=radio@iluma.gr
SMTP_FROM_NAME="Deseo Radio"
SMTP_REPLY_TO=radio@iluma.gr

# Cloudflare Turnstile for /dj inquiry form and /iluma CMS login
# Create a Turnstile widget for deseoradio.com in Cloudflare.
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_HOSTNAME=deseoradio.com

# Cloudflare Web Analytics
# Use the site token from Cloudflare Web Analytics -> Manage site.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=your_cloudflare_web_analytics_token




# Webpushr REST API for MyLive push notifications
# Keep the real values only in the server-side .env outside public_html.
WEBPUSHR_KEY=your_webpushr_rest_api_key
WEBPUSHR_AUTH_TOKEN=your_webpushr_authentication_token

# HearThis integration (server-side only; outside public_html)
# IMPORTANT: Remains OFF until HearThis confirms its write/upload API contract.
HEARTHIS_API_KEY=your_hearthis_key
HEARTHIS_API_SECRET=your_hearthis_secret
HEARTHIS_USERNAME=deseoradio
HEARTHIS_UPLOAD_ENABLED=0
# The HTTPS endpoint must be confirmed by HearThis; never guess /api-v2 upload routes.
HEARTHIS_UPLOAD_ENDPOINT=
# Only after the provider verifies its authentication contract: basic or headers
HEARTHIS_UPLOAD_AUTH_MODE=
